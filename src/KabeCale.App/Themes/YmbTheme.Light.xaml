<!--
  YMB 共通デザイントークン (WPF 系) — ライトテーマの面・文字・意味色
  正本: ymb-ui/YmbTheme.Light.xaml
  キー名は Dark 版と完全に対応。差し替えだけでテーマ切替できる状態を保つ。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 面 ===== -->
    <SolidColorBrush x:Key="YmbBgBrush" Color="#F5F6F8" />
    <SolidColorBrush x:Key="YmbBgTranslucentBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="YmbSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="YmbSurfaceAltBrush" Color="#F7F7F7" />
    <SolidColorBrush x:Key="YmbBorderBrush" Color="#DDDDDD" />
    <SolidColorBrush x:Key="YmbBorderSoftBrush" Color="#EEEEEE" />
    <SolidColorBrush x:Key="YmbRowHoverBrush" Color="#F8F8F8" />
    <SolidColorBrush x:Key="YmbOverlayHoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="YmbOverlayPressBrush" Color="#22000000" />

    <!-- ===== 文字 ===== -->
    <SolidColorBrush x:Key="YmbFgBrush" Color="#222222" />
    <SolidColorBrush x:Key="YmbFgDimBrush" Color="#555555" />
    <SolidColorBrush x:Key="YmbFgMutedBrush" Color="#777777" />

    <!-- ===== 意味色 ===== -->
    <SolidColorBrush x:Key="YmbDangerBrush" Color="#C0392B" />
    <SolidColorBrush x:Key="YmbGoodBrush" Color="#1D7A32" />
    <SolidColorBrush x:Key="YmbWarningBrush" Color="#A06800" />
    <SolidColorBrush x:Key="YmbLinkBrush" Color="#0B5ED7" />

</ResourceDictionary>
